-- 1. CONFIGURATION
-- ============================================
local KeySystem = {
    -- Put your Linkvertise / LootLabs link here
    GetKeyLink = "https://linkvertise.com/your-link-here", 
    
    -- Change this to your desired key
    SecretKey = "weeklykey-6767sigma",
    
    -- Option: Set to true if you fetch your key dynamically from Pastebin/GitHub
    UseRemoteKey = false, 
    RemoteKeyURL = "https://raw.githubusercontent.com/User/Repo/main/key.txt"
}

-- ============================================
-- 2. KEY CHECKER FUNCTION
-- ============================================
local function IsKeyValid(input)
    if KeySystem.UseRemoteKey then
        local success, result = pcall(function()
            return game:HttpGet(KeySystem.RemoteKeyURL)
        end)
        if success and result then
            local validKey = result:gsub("%s+", "")
            return input == validKey
        end
        return false
    else
        return input == KeySystem.SecretKey
    end
end

