-- Copy Link to Clipboard
GetKeyBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(KeySystem.GetKeyLink)
        StatusLabel.Text = "Copied link to clipboard!"
        StatusLabel.TextColor3 = Color3.fromRGB(80, 200, 120)
    else
        StatusLabel.Text = "Clipboard not supported by executor."
        StatusLabel.TextColor3 = Color3.fromRGB(230, 80, 80)
    end
end)

-- Validate Key & Execute Main Script
SubmitBtn.MouseButton1Click:Connect(function()
    local userKey = KeyBox.Text
    
    if IsKeyValid(userKey) then
        StatusLabel.Text = "Key Verified! Loading..."
        StatusLabel.TextColor3 = Color3.fromRGB(80, 200, 120)
        
        task.wait(1)
        ScreenGui:Destroy() -- Destroy UI before executing script
        
        -- ========================================
        -- EXECUTE MAIN SCRIPT
        -- ========================================
        loadstring(game:HttpGet('https://raw.smokingscripts.org/vertex.lua'))()
        
    else
        StatusLabel.Text = "Invalid Key! Try again."
        StatusLabel.TextColor3 = Color3.fromRGB(230, 80, 80)
        KeyBox.Text = ""
    end
end)
